generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Users {
  id       Int     @id @default(autoincrement())
  name     String
  email    String  @unique
  password String
  provider String  @default("local")
  profile  String?

  userFile UserFile[]
}

model UserFile {
  id          Int    @id @default(autoincrement())
  description String @db.Text
  userId      Int
  files       Json
  user        Users  @relation(fields: [userId], references: [id])
}
